  alternativeSpecializations: []
  endRunQuoteRank1: "La potion a march\xE9 ! \u2026 Pour une fois."
  endRunQuoteMid: Moyen. Pour moi, moyen c'est presque un exploit.
  endRunQuoteLast: "Si c'est rat\xE9, c'est rat\xE9. J'ai l'habitude."
