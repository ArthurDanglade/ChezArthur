  alternativeSpecializations: []
  endRunQuoteRank1: Bouclier en place. Le reste, c'est du bonus.
  endRunQuoteMid: "J'ai encaiss\xE9 pour tout le monde, comme pr\xE9vu."
  endRunQuoteLast: "R\xE9paration express sur mon ego, quelqu'un ?"
