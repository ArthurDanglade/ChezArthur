  alternativeSpecializations: []
  endRunQuoteRank1: "Banni quatorze fois, premier une fois. \xC7a change."
  endRunQuoteMid: "Pas expuls\xE9 du podium. D\xE9j\xE0 une victoire morale."
  endRunQuoteLast: Bon, je sors. Comme d'habitude.
