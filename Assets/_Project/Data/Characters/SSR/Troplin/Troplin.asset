  endRunQuoteRank1: "Premier ! Une petite bi\xE8re pour f\xEAter \xE7a ?"
  endRunQuoteMid: "Ma foi, je m'en contente. Petite bi\xE8re pour f\xEAter \xE7a
    quand m\xEAme ?"
